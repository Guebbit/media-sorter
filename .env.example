##############################################################################
# mediasort — configuration
#
# Copy to `.env` and edit. Every setting below already has a working default.
# A real environment variable wins over this file.
#
# The photo folders and output folder are usually set with
# `mediasort config set --input ... --output ...`, the web UI, or `--input` /
# `--output` per run — a saved choice beats anything exported here.
#
# Everything else — state paths, worker counts, detector batch size, Ollama
# transport, web host/port — lives in app/config/env.py with its
# defaults; `mediasort doctor` prints which are in force.
##############################################################################

# Only the transport and the models live here. Confidence, review confidence,
# and whether to ask Ollama for a second opinion at all are per class condition
# — set them in the rule editor or rules.json.
MEDIASORT_OLLAMA_URL=http://127.0.0.1:11434
MEDIASORT_OLLAMA_MODEL=qwen3-vl:30b
MEDIASORT_DETECT_MODEL=yolo11m.pt

# Videos are sorted by what YOLO finds in this many frames, sampled evenly
# across each file. One video then costs about what this many photos cost.
# `0` turns it off: videos are matched by extension alone, and only the
# `video` class ever applies to one.
MEDIASORT_DETECT_VIDEO_FRAMES=8
