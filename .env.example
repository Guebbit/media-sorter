##############################################################################
# photosort — configuration
#
# Copy to `.env` and edit. Nothing in here is required: every setting below
# already has a working default.
#
# Read from the project folder (or any parent, up to four levels) whenever
# photosort starts. A real environment variable wins over this file, so a
# one-off override needs no editing:
#
#   PHOTOSORT_OLLAMA_MODEL=llava:13b photosort analyze
#
# The photo folders and the output folder are deliberately NOT here — they are
# not properties of the machine. Set them once with
#
#   photosort config set --input /path/to/photos --output ./output
#
# or in the web UI's Settings tab, or per run with `--input` / `--output`.
# PHOTOSORT_INPUT_FOLDERS and PHOTOSORT_OUTPUT_FOLDER are ignored.
#
# This is everything else worth setting. The remaining settings — state paths,
# worker counts, detector batch size, Ollama transport, web host and port — are
# in photosort/config/env.py with their defaults, and `photosort doctor` prints
# which of them are in force.
##############################################################################

# --- the two Ollama passes; the web UI and `config set` can change all four ---
# When the detector half-sees something (between the two confidences below),
# ask the vision model whether it is really there. Confirmed photos are sorted
# as normal matches, rejected ones stop being flagged, and what the model cannot
# settle either goes to the review folder for you. Off means uncertain photos go
# straight to review. Cheap: it only runs on the uncertain ones.
PHOTOSORT_ADJUDICATE_ENABLED=1
# Describe the photos the rules kept, so `photosort search` can find them. Slow,
# and it never changes where a photo is sorted.
PHOTOSORT_ANALYZE_ENABLED=1
# The Ollama you already run. Nothing is started for you.
PHOTOSORT_OLLAMA_URL=http://127.0.0.1:11434
# A bare name resolves to whatever tag is installed, so this finds
# llava-llama3:8b. qwen2.5-vl follows the JSON schema more reliably.
PHOTOSORT_OLLAMA_MODEL=qwen3-vl:30b

# --- what to look for --------------------------------------------------------
# Seeds the FIRST rules file only; after that the rules are the source of truth
# and the web UI is where you edit them. Any COCO class works, plus the special
# "video" class: no model looks at video files, a rule just matches them by
# extension (.mp4, .mov, .mkv, ...) instead.
PHOTOSORT_STARTER_CLASSES=cat,dog,video

# yolo11n (fast) … yolo11x (accurate). Downloaded once on first use.
PHOTOSORT_DETECT_MODEL=yolo11m.pt

# --- what it does with them --------------------------------------------------
# A rule with action "move" relocates the original instead of copying it: no
# duplicates, no links, and nothing left in the folder it came from. A rule
# with action "delete" moves the original to the trash folder — always
# recoverable, never permanent. Neither does anything unless you also pass
# --yes (or tick the confirm checkbox in the web UI): that is the one lock
# there is, since running natively means your photos are as writable to this
# tool as to anything else you run. Preview first.
#
# The detector confidence band (what score counts as a match, and the band
# below it that gets escalated to the second opinion) is not set here either —
# it has a working default and is otherwise a CLI/web-UI setting:
#   photosort config set --confidence 0.65 --review-confidence 0.35
# or the "Confidence (YOLO)" / "AI Review (Ollama)" fields in the Settings tab.
