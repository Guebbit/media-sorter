##############################################################################
# mediasort — configuration
#
# Copy to `.env` and edit. Every setting below already has a working default.
# A real environment variable wins over this file.
#
# The photo folders and output folder are NOT here — set them with
# `mediasort config set --input ... --output ...`, the web UI, or `--input` /
# `--output` per run. MEDIASORT_INPUT_FOLDERS / MEDIASORT_OUTPUT_FOLDER are
# ignored.
#
# Everything else — state paths, worker counts, detector batch size, Ollama
# transport, web host/port — lives in app/config/env.py with its
# defaults; `mediasort doctor` prints which are in force.
##############################################################################

# The semantic pass (for `mediasort search`) always runs, and the second
# opinion on uncertain detections is a per-rule choice now — set confidence,
# review confidence, and whether to ask Ollama at all on each class condition
# in the rule editor / rules.json, not here.
MEDIASORT_OLLAMA_URL=http://127.0.0.1:11434
MEDIASORT_OLLAMA_MODEL=qwen3-vl:30b
MEDIASORT_DETECT_MODEL=yolo11m.pt
